# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).
#
# Supabase → Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("anon" / "publishable"): usada só para o login do admin.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta ("service_role" / "secret"): NUNCA exponha no navegador
# nem faça commit dela. Usada pelo servidor para ler/gravar as fichas.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails (separados por vírgula) que podem entrar em /admin. Cada um
# precisa também de um usuário criado em Supabase → Authentication → Users.
ADMIN_EMAILS=admin@exemplo.com
